# Never commit a real .env. Node/Neo4j/OpenAI credentials stay on the server.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_ME
NEO4J_DATABASE=neo4j
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1
OPENAI_STRUCTURED_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATA_FILE=C:/Projects/problem-explorer/data/problems.csv
AUTH_DB_PATH=./data/auth.sqlite3
AUTH_SECURE_COOKIE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
DAILY_AI_REQUEST_LIMIT=15
AUTO_INDEX_SHARED=false
