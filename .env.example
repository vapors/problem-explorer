# Rename to .env. Never commit this file or expose ports 7687 / 7474 publicly.
NEO4J_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1
OPENAI_STRUCTURED_MODEL=gpt-4.1-mini
NEO4J_DATABASE=neo4j
CORS_ORIGINS=http://localhost:5173

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Auth: keep this SQLite DB outside deployed application directories on production.
AUTH_DB_PATH=./data/auth.sqlite3
# false for HTTP-only local development, true behind HTTPS production
AUTH_SECURE_COOKIE=false
# Create OAuth 2.0 Web Client ID in Google Cloud; allowed origin is your site.
GOOGLE_CLIENT_ID=
# Comma-separated additional allowed browser origins (used for CSRF protection)
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum AI-backed requests per authenticated user each UTC day
DAILY_AI_REQUEST_LIMIT=15
 